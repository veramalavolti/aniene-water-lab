{% extends "base.html.j2" %}
{% import "parti.html.j2" as parti %}

{% block contenuto %}

{{ parti.hero(c, 'Campagna di monitoraggio') }}

<section class="sezione">
  <div class="contenitore">
    <div class="doppia">
      <div>
        {{ parti.testa('2021', c.walkup.titolo) }}
        {{ parti.paragrafi(c.walkup.paragrafi) }}
        <div class="nota">
          <p>{{ c.walkup.mappa.testo }}</p>
          <p><a href="{{ c.walkup.mappa.link }}" rel="noopener">{{ c.walkup.mappa.link_testo }} ↗</a></p>
        </div>
      </div>
      <div>
        {{ parti.testa('2022 – 2023', c.romaup.titolo) }}
        {{ parti.paragrafi(c.romaup.paragrafi) }}
        <figure class="foto-larga" style="margin-bottom:0">
          <img src="assets/img/{{ c.romaup.foto }}" alt="{{ c.romaup.foto_descrizione }}" loading="lazy" width="1200" height="800">
          <figcaption>{{ c.romaup.foto_descrizione }}</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<section class="sezione" id="luoghi">
  <div class="contenitore">
    {{ parti.testa('Dove', c.luoghi.titolo) }}
    {{ parti.luoghi(c.luoghi, mappa_svg(c.dashboard.dati, 760, verticale=true)) }}
  </div>
</section>

<section class="sezione sezione-chiara" id="analisi">
  <div class="contenitore">
    {{ parti.testa('Il protocollo', c.analisi.titolo) }}
    <div class="testo-lato">
      <div>
        {{ parti.paragrafi(c.analisi.paragrafi) }}
        <p class="bottoni" style="margin-bottom:0">
          <a class="bottone" href="citizen-science.html#parametri">{{ c.analisi.rimando }} →</a>
        </p>
      </div>
      <div class="spalla">
        {# Il LIMeco torna spesso nel testo: qui si dice che cos'è e si manda
           alla spiegazione per esteso, invece di lasciare la colonna vuota. #}
        <aside class="richiamo">
          <p class="etichetta">{{ c.analisi.limeco.etichetta }}</p>
          <h3>{{ c.analisi.limeco.titolo }}</h3>
          {{ parti.paragrafi(c.analisi.limeco.paragrafi) }}
          <a class="bottone bottone-piccolo" href="{{ c.analisi.limeco.link }}">{{ c.analisi.limeco.link_testo }} →</a>
        </aside>
      </div>
    </div>
  </div>
</section>

<section class="sezione" id="dashboard">
  <div class="contenitore">
    {{ parti.dashboard(c.dashboard, riepilogo, impostazioni.guida_dashboard) }}
  </div>
</section>

<section class="sezione sezione-chiara" id="schede">
  <div class="contenitore">
    {{ parti.schede_campagna(c.schede, parametri) }}
  </div>
</section>

<section class="sezione" id="report">
  <div class="contenitore">
    {{ parti.report(c.report, peso, pagine) }}
  </div>
</section>

{% endblock %}

{% block script %}
<script src="assets/js/dashboard.js?v={{ versione.js }}" defer></script>
{% endblock %}
