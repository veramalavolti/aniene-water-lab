{% extends "base.html.j2" %}
{% import "parti.html.j2" as parti %}

{% block contenuto %}

{{ parti.hero(c, 'Campagna di monitoraggio') }}

<nav class="sottomenu" aria-label="Le due sezioni della campagna">
  <div class="contenitore sottomenu-interno">
    <span class="sottomenu-titolo">In questa pagina</span>
    {% for s in c.introduzione.sezioni %}
    <a href="#{{ s.ancora }}" data-sezione="{{ s.ancora }}">{{ s.nome }}</a>
    {% endfor %}
    <a href="#report" data-sezione="report">I report</a>
    <a href="#rete" data-sezione="rete">La rete</a>
  </div>
</nav>

<section class="sezione">
  <div class="contenitore">
    <div class="testo-lato">
      <div>
        {{ parti.paragrafi(c.introduzione.paragrafi) }}
        {{ parti.bottoni_sezione(c.introduzione.sezioni) }}
      </div>
      <div class="spalla">
        <div class="spalla-numeri">
          <h3>{{ c.introduzione.spalla.titolo }}</h3>
          <dl>
            {% for v in c.introduzione.spalla.voci %}
            <div>
              <dt>{{ v.valore }}</dt>
              <dd>{{ v.testo|t }}</dd>
            </div>
            {% endfor %}
          </dl>
        </div>
      </div>
    </div>
  </div>
</section>

{# ------------------------------------------------------------- punti fissi #}

<section class="sezione-scura" id="dati-fissi">
  <div class="contenitore">
    {{ parti.testa('Sezione 1', c.fissi.titolo) }}
    <div class="luoghi">
      <div class="capitolo-testo">{{ parti.paragrafi(c.fissi.intro.paragrafi) }}</div>
      <figure class="mappa">
        {{ mappa_svg(c.fissi.dashboard.dati, 340) }}
        <figcaption>{{ c.fissi.intro.mappa_didascalia }}</figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="sezione">
  <div class="contenitore">
    {{ parti.dashboard(c.fissi.dashboard, riepilogo, impostazioni.guida_dashboard) }}
  </div>
</section>

<section class="sezione sezione-chiara">
  <div class="contenitore">
    {{ parti.testa('', c.fissi.sintesi.titolo) }}
    {{ parti.sintesi_con_spalla(c.fissi.sintesi) }}
  </div>
</section>

<section class="sezione">
  <div class="contenitore">
    {{ parti.schede_campagna(c.fissi.schede, parametri) }}
    <div style="margin-top:2rem">
      {{ parti.galleria(c.fissi.foto) }}
    </div>
    <p class="bottoni" style="margin-top:2rem">
      <a class="bottone" href="#dati-gommone">Vai ai dati in gommone ↓</a>
    </p>
  </div>
</section>

{# ----------------------------------------------------------------- gommone #}

<section class="sezione-scura" id="dati-gommone">
  <div class="contenitore">
    {{ parti.testa('Sezione 2', c.gommone.titolo) }}
    {{ parti.paragrafi(c.gommone.intro.paragrafi) }}
    <figure class="mappa" style="margin:1.6rem 0 0">
      {{ mappa_svg(c.gommone.dashboard.dati, 380) }}
      <figcaption>{{ c.gommone.intro.mappa_didascalia }}</figcaption>
    </figure>
    <div class="nota" style="background:rgba(240,237,230,.08);color:var(--text-inv-dim);border-left-color:var(--lime)">
      <p><b>{{ c.gommone.intro.come_leggere.titolo }}.</b> {{ c.gommone.intro.come_leggere.testo|t }}</p>
    </div>
  </div>
</section>

<section class="sezione">
  <div class="contenitore">
    {{ parti.dashboard(c.gommone.dashboard, riepilogo, impostazioni.guida_dashboard) }}
  </div>
</section>

<section class="sezione sezione-chiara">
  <div class="contenitore">
    {{ parti.testa('', c.gommone.sintesi.titolo) }}
    <ul class="elenco-spunte">
      {% for v in c.gommone.sintesi.voci %}
      <li><b>{{ v.titolo }}.</b> {{ v.testo }}</li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="sezione">
  <div class="contenitore">
    {{ parti.schede_campagna(c.gommone.schede, parametri) }}
  </div>
</section>

<section class="sezione" id="hotspot">
  <div class="contenitore">
    {{ parti.testa('Dove guardare', c.gommone.hotspot.titolo, c.gommone.hotspot.intro) }}
    <div class="testo-lato">
      <div>
        <ul class="elenco-spunte">
          {% for criterio in c.gommone.hotspot.criteri %}
          <li>{{ criterio }}</li>
          {% endfor %}
        </ul>
        <div style="margin-top:1.6rem">{{ parti.paragrafi(c.gommone.hotspot.chiusura) }}</div>
      </div>
      <div class="spalla">
        <div class="riquadro hotspot-box">
          <h3>{{ c.gommone.hotspot.elenco_titolo }}</h3>
          <ul class="hotspot-elenco">
            {% for h in c.gommone.hotspot.elenco %}
            <li><b>{{ h.data }}</b> <span>{{ h.punti }}</span></li>
            {% endfor %}
          </ul>
          <p class="hotspot-rimando">{{ c.gommone.hotspot.rimando|t }}</p>
          <a class="bottone bottone-piccolo" href="#report">Vai ai report →</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="sezione">
  <div class="contenitore">
    {{ parti.testa('Come', c.gommone.metodologia.titolo) }}
    <ul class="elenco-spunte">
      {% for v in c.gommone.metodologia.voci %}
      <li><b>{{ v.titolo }}.</b> {{ v.testo }}</li>
      {% endfor %}
    </ul>
    <div style="margin-top:2rem">
      {{ parti.galleria(c.gommone.foto) }}
    </div>
    <p class="bottoni" style="margin-top:2rem">
      <a class="bottone bottone-chiaro" href="#dati-fissi">Torna ai dati dei punti fissi ↑</a>
    </p>
  </div>
</section>

<section class="sezione sezione-chiara" id="report">
  <div class="contenitore">
    {{ parti.report(c.report, peso, pagine) }}
  </div>
</section>

{{ parti.rete(c.rete) }}

{% endblock %}

{% block script %}
<script src="assets/js/dashboard.js?v={{ versione.js }}" defer></script>
<script>
/* Segna nella barra la sezione che si sta leggendo. Le due metà della pagina
   sono fatte di più sezioni ciascuna, quindi non basta osservare un solo
   blocco: si guarda quale ancora è l'ultima passata sopra la barra. */
(function () {
  var barra = document.querySelector('.sottomenu');
  if (!barra) return;
  var voci = Array.prototype.map.call(
    barra.querySelectorAll('a[data-sezione]'),
    function (a) { return { link: a, sezione: document.getElementById(a.dataset.sezione) }; }
  ).filter(function (v) { return v.sezione; });
  if (!voci.length) return;

  var inAttesa = false;
  function aggiorna() {
    inAttesa = false;
    var soglia = window.scrollY + barra.getBoundingClientRect().height + 90;
    var attiva = null;
    voci.forEach(function (v) {
      if (v.sezione.getBoundingClientRect().top + window.scrollY <= soglia) attiva = v;
    });
    // in fondo alla pagina l'ultima sezione non arriva mai sotto la barra:
    // se si è arrivati al fondo, è quella che si sta leggendo
    var fondo = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
    if (fondo) attiva = voci[voci.length - 1];
    voci.forEach(function (v) {
      if (v === attiva) v.link.setAttribute('aria-current', 'true');
      else v.link.removeAttribute('aria-current');
    });
  }
  function chiedi() {
    if (inAttesa) return;
    inAttesa = true;
    window.requestAnimationFrame(aggiorna);
  }
  window.addEventListener('scroll', chiedi, { passive: true });
  window.addEventListener('resize', chiedi);
  aggiorna();
})();
</script>
{% endblock %}
