{% extends "base.html.j2" %}
{% import "parti.html.j2" as parti %}

{% block contenuto %}

{{ parti.hero(c, 'Campagna di monitoraggio') }}

<nav class="sottomenu" aria-label="Le due sezioni della campagna">
  <div class="contenitore sottomenu-interno">
    <span class="sottomenu-titolo">In questa pagina</span>
    {% for s in c.introduzione.sezioni %}
    <a href="#{{ s.ancora }}" data-sezione="{{ s.ancora }}">{{ s.nome }}</a>
    {% endfor %}
    <a href="#report" data-sezione="report">I report</a>
  </div>
</nav>

<section class="sezione">
  <div class="contenitore stretto">
    {{ parti.paragrafi(c.introduzione.paragrafi) }}
    {{ parti.bottoni_sezione(c.introduzione.sezioni) }}
  </div>
</section>

{# ------------------------------------------------------------- punti fissi #}

<section class="sezione-scura" id="dati-fissi">
  <div class="contenitore">
    {{ parti.testa('Sezione 1', c.fissi.titolo) }}
    <div class="luoghi">
      <div class="capitolo-testo">{{ parti.paragrafi(c.fissi.intro.paragrafi) }}</div>
      <figure class="mappa">
        {{ mappa_svg(c.fissi.dashboard.dati, 340) }}
        <figcaption>{{ c.fissi.intro.mappa_didascalia }}</figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="sezione">
  <div class="contenitore">
    {{ parti.dashboard(c.fissi.dashboard, riepilogo) }}
  </div>
</section>

<section class="sezione sezione-chiara">
  <div class="contenitore stretto">
    {{ parti.testa('', c.fissi.sintesi.titolo) }}
    {{ parti.paragrafi(c.fissi.sintesi.paragrafi) }}
  </div>
</section>

<section class="sezione">
  <div class="contenitore">
    {{ parti.schede_campagna(c.fissi.schede, parametri) }}
    <div style="margin-top:2rem">
      {{ parti.galleria(c.fissi.foto) }}
    </div>
    <p class="bottoni" style="margin-top:2rem">
      <a class="bottone" href="#dati-gommone">Vai ai dati in gommone ↓</a>
    </p>
  </div>
</section>

{# ----------------------------------------------------------------- gommone #}

<section class="sezione-scura" id="dati-gommone">
  <div class="contenitore">
    {{ parti.testa('Sezione 2', c.gommone.titolo) }}
    {{ parti.paragrafi(c.gommone.intro.paragrafi) }}
    <figure class="mappa" style="margin:1.6rem 0 0">
      {{ mappa_svg(c.gommone.dashboard.dati, 380) }}
      <figcaption>{{ c.gommone.intro.mappa_didascalia }}</figcaption>
    </figure>
    <div class="nota" style="background:rgba(240,237,230,.08);color:var(--text-inv-dim);border-left-color:var(--lime)">
      <p><b>{{ c.gommone.intro.come_leggere.titolo }}.</b> {{ c.gommone.intro.come_leggere.testo|t }}</p>
    </div>
  </div>
</section>

<section class="sezione">
  <div class="contenitore">
    {{ parti.dashboard(c.gommone.dashboard, riepilogo) }}
  </div>
</section>

<section class="sezione sezione-chiara">
  <div class="contenitore">
    {{ parti.testa('', c.gommone.sintesi.titolo) }}
    <ul class="elenco-spunte">
      {% for v in c.gommone.sintesi.voci %}
      <li><b>{{ v.titolo }}.</b> {{ v.testo }}</li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="sezione">
  <div class="contenitore">
    {{ parti.schede_campagna(c.gommone.schede, parametri) }}
  </div>
</section>

<section class="sezione" id="hotspot">
  <div class="contenitore stretto">
    {{ parti.testa('Dove guardare', c.gommone.hotspot.titolo, c.gommone.hotspot.intro) }}
    <ul class="elenco-spunte">
      {% for criterio in c.gommone.hotspot.criteri %}
      <li>{{ criterio }}</li>
      {% endfor %}
    </ul>
    <h3 class="sotto-titolo">{{ c.gommone.hotspot.elenco_titolo }}</h3>
    <ul class="stazioni-elenco">
      {% for h in c.gommone.hotspot.elenco %}
      <li>
        <span class="stazione-codice">H</span>
        <div>
          <span class="stazione-nome">{{ h.data }}</span>
          <p>{{ h.punti }}</p>
        </div>
      </li>
      {% endfor %}
    </ul>
    <div style="margin-top:1.4rem">{{ parti.paragrafi(c.gommone.hotspot.chiusura) }}</div>
  </div>
</section>

<section class="sezione">
  <div class="contenitore">
    {{ parti.testa('Come', c.gommone.metodologia.titolo) }}
    <ul class="elenco-spunte">
      {% for v in c.gommone.metodologia.voci %}
      <li><b>{{ v.titolo }}.</b> {{ v.testo }}</li>
      {% endfor %}
    </ul>
    <div style="margin-top:2rem">
      {{ parti.galleria(c.gommone.foto) }}
    </div>
    <p class="bottoni" style="margin-top:2rem">
      <a class="bottone bottone-chiaro" href="#dati-fissi">Torna ai dati dei punti fissi ↑</a>
    </p>
  </div>
</section>

<section class="sezione sezione-chiara" id="report">
  <div class="contenitore">
    {{ parti.report(c.report, peso, pagine) }}
  </div>
</section>

{% endblock %}

{% block script %}
<script src="assets/js/dashboard.js?v={{ versione.js }}" defer></script>
<script>
/* Segna nella barra la sezione che si sta leggendo. Senza, in una pagina così
   lunga non si capisce se si è nei punti fissi o nel gommone. */
(function () {
  var barra = document.querySelector('.sottomenu');
  if (!barra || !('IntersectionObserver' in window)) return;
  var voci = {};
  barra.querySelectorAll('a[data-sezione]').forEach(function (a) {
    voci[a.dataset.sezione] = a;
  });
  var sezioni = Object.keys(voci)
    .map(function (id) { return document.getElementById(id); })
    .filter(Boolean);

  var osservatore = new IntersectionObserver(function (voci_viste) {
    voci_viste.forEach(function (v) {
      var a = voci[v.target.id];
      if (!a) return;
      if (v.isIntersecting) {
        Object.keys(voci).forEach(function (k) { voci[k].removeAttribute('aria-current'); });
        a.setAttribute('aria-current', 'true');
      }
    });
  }, { rootMargin: '-45% 0px -50% 0px' });

  sezioni.forEach(function (s) { osservatore.observe(s); });
})();
</script>
{% endblock %}
