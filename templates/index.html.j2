{% extends "base.html.j2" %}
{% import "parti.html.j2" as parti %}

{% block titolo %}{{ impostazioni.sito.nome }} · {{ c.titolo }}{% endblock %}
{% block descrizione %}{{ impostazioni.sito.descrizione }}{% endblock %}

{% block contenuto %}

<section class="hero">
  <div class="contenitore hero-griglia">
    <div>
      <p class="hero-occhiello">Dal 2021 a oggi</p>
      <h1>{{ c.titolo }}</h1>
      <p>{{ c.sottotitolo|t }}</p>
    </div>
    <figure>
      <img src="assets/img/{{ c.foto_copertina }}" alt="{{ c.foto_copertina_descrizione }}" width="1800" height="1200">
      <figcaption>{{ c.foto_copertina_descrizione }}</figcaption>
    </figure>
  </div>
</section>

<section class="sezione sezione-chiara" id="campagne">
  <div class="contenitore">
    <p class="etichetta">Le campagne di monitoraggio</p>
    <h2 class="sr-only">Le campagne di monitoraggio</h2>
    <div class="campagne-griglia">
      {% for b in c.campagne %}
      <a class="campagna-box" href="{{ b.pagina }}.html">
        <span class="campagna-anni">{{ b.anni }}</span>
        <span class="campagna-nome">{{ b.nome }}</span>
        <span class="campagna-desc">{{ b.descrizione }}</span>
        <span class="campagna-vai">Vedi i risultati →</span>
      </a>
      {% endfor %}
    </div>
    <div class="numeri numeri-chiari">
      {% for n in c.numeri %}
      <div>
        <div class="numero-valore">{{ n.valore }}</div>
        <div class="numero-etichetta">{{ n.etichetta }}</div>
        <div class="numero-dettaglio">{{ n.dettaglio }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="sezione" id="contesto">
  <div class="contenitore">
    <div class="doppia">
      <div>
        {{ parti.testa('Il contesto', c.fiume.titolo) }}
        {{ parti.paragrafi(c.fiume.paragrafi[:2]) }}
        <figure class="foto-inserita">
          <img src="assets/img/{{ c.fiume.foto }}" alt="{{ c.fiume.foto_descrizione }}" loading="lazy" width="1200" height="800">
          <figcaption>{{ c.fiume.foto_descrizione }}</figcaption>
        </figure>
        {{ parti.paragrafi(c.fiume.paragrafi[2:]) }}
      </div>
      <div id="progetto">
        {{ parti.testa('Il percorso', c.progetto.titolo) }}
        <p class="sotto-titolo">{{ c.progetto.sottotitolo }}</p>
        <ul class="cronologia">
          {% for t in c.progetto.tappe %}
          <li>
            <a class="anni-bottone" href="{{ t.pagina }}.html">{{ t.anni }} →</a>
            <span class="cronologia-nome">{{ t.nome }}</span>
            {{ t.testo|t }}
          </li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="sezione">
  <div class="contenitore foto-affiancata">
    <div>
      <h3 class="sotto-titolo" style="margin-top:0">{{ c.progetto.chi.titolo }}</h3>
      <p>{{ c.progetto.chi.testo|t }}</p>
      <h3 class="sotto-titolo">{{ c.progetto.cosa.titolo }}</h3>
      <ul class="elenco-spunte">
        {% for v in c.progetto.cosa.voci %}
        <li><b>{{ v.titolo }}.</b> {{ v.testo|t }}</li>
        {% endfor %}
      </ul>
    </div>
    <figure>
      <img src="assets/img/{{ c.progetto.foto }}" alt="{{ c.progetto.foto_descrizione }}" loading="lazy" width="1800" height="1200">
      <figcaption>{{ c.progetto.foto_descrizione }}</figcaption>
    </figure>
  </div>
</section>

<section class="sezione-scura" id="contratto-di-fiume">
  <div class="contenitore">
    {{ parti.testa('Lo strumento', c.contratto.titolo) }}
    {{ parti.foto_larga(c.contratto.foto, c.contratto.foto_descrizione) }}
    <div class="affiancate">
      <div>
        <h3 class="sotto-titolo" style="color:var(--lime)">{{ c.contratto.cosa_e.titolo }}</h3>
        {{ parti.paragrafi(c.contratto.cosa_e.paragrafi) }}
      </div>
      <div>
        <h3 class="sotto-titolo" style="color:var(--lime)">{{ c.contratto.aniene.titolo }}</h3>
        {{ parti.paragrafi(c.contratto.aniene.paragrafi) }}
      </div>
    </div>
    <div class="numeri">
      {% for n in c.contratto.aniene.numeri %}
      <div>
        <div class="numero-valore">{{ n.valore }}</div>
        <div class="numero-etichetta">{{ n.etichetta }}</div>
      </div>
      {% endfor %}
    </div>
    <p class="bottoni">
      <a class="bottone" href="{{ c.contratto.aniene.link }}" rel="noopener">{{ c.contratto.aniene.link_testo }} ↗</a>
    </p>
  </div>
</section>

<section class="sezione" id="citizen-science">
  <div class="contenitore">
    {{ parti.testa('Il metodo', c.citizen_science.titolo) }}
    <div class="cs-griglia">
      <div class="cs-testo">
        {{ parti.paragrafi(c.citizen_science.paragrafi) }}
        <p class="bottoni">
          <a class="bottone" href="citizen-science.html">Approfondisci la citizen science →</a>
        </p>
      </div>
      <div class="griglia-foto">
        {% for f in c.citizen_science.foto_griglia %}
        <figure{% if f.get('larga') %} class="larga"{% endif %}>
          <img src="assets/img/{{ f.file }}" alt="{{ f.didascalia }}" loading="lazy" width="1200" height="800">
          <figcaption>{{ f.didascalia }}</figcaption>
        </figure>
        {% endfor %}
      </div>
    </div>

    <h3 class="sotto-titolo" style="margin-top:2.6rem">{{ c.citizen_science.card_titolo }}</h3>
    <div class="vantaggi">
      {% for s in c.citizen_science.card %}
      <article>
        <b>{{ '%02d'|format(loop.index) }}</b>
        <h4>{{ s.titolo }}</h4>
        <p>{{ s.testo|t }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section class="sezione" id="metodologia">
  <div class="contenitore">
    {{ parti.testa('Come lavoriamo', c.metodologia.titolo) }}
    <div class="metodo-griglia">
      <div class="capitolo-testo">
        {{ parti.paragrafi(c.metodologia.paragrafi) }}
        <p class="bottoni" style="margin-bottom:0">
          <a class="bottone" href="citizen-science.html#parametri">{{ c.metodologia.approfondisci }} →</a>
        </p>
      </div>
      <aside class="fww fww-stretto">
        <div>
          <p class="etichetta">{{ c.metodologia.fresh_water_watch.etichetta }}</p>
          <h3>{{ c.metodologia.fresh_water_watch.titolo }}</h3>
          <p>{{ c.metodologia.fresh_water_watch.testo|t }}</p>
          <p class="bottoni" style="margin-bottom:0">
            <a class="bottone" href="{{ c.metodologia.fresh_water_watch.link }}" rel="noopener">{{ c.metodologia.fresh_water_watch.link_testo }} ↗</a>
          </p>
        </div>
        <div class="qr-coppia">
          {% for q in c.metodologia.fresh_water_watch.qr %}
          <div class="fww-qr">
            <img src="assets/img/{{ q.immagine }}" alt="{{ q.descrizione }}" width="150" height="150">
            <strong>{{ q.etichetta }}</strong>
            <span>{{ q.descrizione }}</span>
          </div>
          {% endfor %}
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="sezione" id="obiettivi">
  <div class="contenitore">
    <div class="obiettivi">
      <h2 class="titolo-sezione">{{ c.obiettivi.titolo }}</h2>
      <p class="occhiello-testo">{{ c.obiettivi.intro|t }}</p>
      <div class="obiettivi-griglia">
        {% for v in c.obiettivi.voci %}
        <div>
          <b>{{ '%02d'|format(loop.index) }}</b>
          <p>{{ v|t }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<section class="sezione" id="ringraziamenti">
  <div class="contenitore">
    {{ parti.testa_doppia('La rete', c.ringraziamenti.titolo, c.ringraziamenti.testo) }}
    <div class="loghi">
      {% for g in loghi %}
      {% set d = dimensioni(g.logo) %}
      <span class="logo-box"><img src="assets/img/{{ g.logo }}" alt="{{ g.nome }}"
            loading="lazy"{% if d[0] %} width="{{ d[0] }}" height="{{ d[1] }}"{% endif %}></span>
      {% endfor %}
    </div>
    <p class="bottoni">
      <a class="bottone" href="contatti.html">Vedi tutti i partner e scrivici →</a>
    </p>
  </div>
</section>

{% endblock %}
