{% extends "base.html.j2" %}
{% import "parti.html.j2" as parti %}

{% macro capitolo(blocchi) %}
<div class="capitolo">
  {% for b in blocchi %}
  {% if b.get('foto') %}
  <div class="capitolo-blocco{% if b.lato == 'sinistra' %} rovescio{% endif %}">
    {% if b.lato == 'sinistra' %}
    <figure>
      <img src="assets/img/{{ b.foto.file }}" alt="{{ b.foto.descrizione }}" loading="lazy" width="1200" height="800">
      <figcaption>{{ b.foto.descrizione }}</figcaption>
    </figure>
    {% endif %}
    <div class="capitolo-testo">
      <h3 class="sotto-titolo" style="margin-top:0">{{ b.titolo }}</h3>
      {{ parti.paragrafi(b.paragrafi) }}
    </div>
    {% if b.lato != 'sinistra' %}
    <figure>
      <img src="assets/img/{{ b.foto.file }}" alt="{{ b.foto.descrizione }}" loading="lazy" width="1200" height="800">
      <figcaption>{{ b.foto.descrizione }}</figcaption>
    </figure>
    {% endif %}
  </div>
  {% else %}
  <div class="capitolo-testo">
    <h3 class="sotto-titolo" style="margin-top:0">{{ b.titolo }}</h3>
    {{ parti.paragrafi(b.paragrafi) }}
  </div>
  {% endif %}
  {% endfor %}
</div>
{% endmacro %}

{% block contenuto %}

{{ parti.hero(c, 'Il metodo', compatto=true) }}

<section class="sezione">
  <div class="contenitore">
    {{ parti.testa('', c.scienza_partecipata.titolo) }}
    {{ parti.foto_larga(c.foto_apertura.file, c.foto_apertura.descrizione) }}
    {{ capitolo(c.scienza_partecipata.blocchi) }}
    <blockquote class="citazione">{{ c.scienza_partecipata.citazione }}</blockquote>
    {{ capitolo(c.scienza_partecipata.blocchi_due) }}
    <div class="riquadro riquadro-largo">
      <h3>{{ c.scienza_partecipata.riquadro.titolo }}</h3>
      <div class="riquadro-colonne">
        {{ parti.paragrafi(c.scienza_partecipata.riquadro.paragrafi) }}
      </div>
    </div>
    <div class="capitolo" style="margin-top:2rem">
      <div class="capitolo-blocco">
        <div class="capitolo-testo">
          <h3 class="sotto-titolo" style="margin-top:0">{{ c.scienza_partecipata.chiusura_titolo }}</h3>
          {{ parti.paragrafi(c.scienza_partecipata.chiusura) }}
        </div>
        <figure>
          <img src="assets/img/{{ c.scienza_partecipata.chiusura_foto.file }}"
               alt="{{ c.scienza_partecipata.chiusura_foto.descrizione }}" loading="lazy" width="1200" height="800">
          <figcaption>{{ c.scienza_partecipata.chiusura_foto.descrizione }}</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>

<section class="sezione sezione-chiara" id="parametri">
  <div class="contenitore">
    {{ parti.testa_doppia('Le schede', c.parametri.titolo, c.parametri.intro) }}
    {{ parti.schede_generali(c.parametri.ordine, parametri) }}
  </div>
</section>

{# L'indice LIMeco: spiegazione, schema e soglie stanno in un blocco solo,
   perché sono tre modi di dire la stessa cosa. #}
<section class="sezione sezione-chiara" id="limeco">
  <div class="contenitore">
    {{ parti.testa_doppia(c.limeco.etichetta, c.limeco.titolo, c.limeco.intro) }}
    <div class="limeco">
      <div class="limeco-testo">
        <div>{{ parti.paragrafi(c.limeco.paragrafi[:2]) }}</div>
        <div>
          {{ parti.paragrafi(c.limeco.paragrafi[2:]) }}
          {{ parti.schema_limeco() }}
        </div>
      </div>
      <div class="limeco-soglie">
        <h3>{{ c.limeco.tabella.titolo }}</h3>
        <div class="tabella-scorrevole">
          <table class="dati">
            <thead>
              <tr>
                <th>{{ c.limeco.tabella.intestazione[0] }}</th>
                {% for v in c.limeco.tabella.intestazione[1:] %}
                <th><span class="classe-tacca lvl-{{ loop.index }}"></span>{{ v }}</th>
                {% endfor %}
              </tr>
            </thead>
            <tbody>
              {% for riga in c.limeco.tabella.righe %}
              <tr>{% for cella in riga %}<td>{{ cella }}</td>{% endfor %}</tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <p class="limeco-nota">{{ c.limeco.nota|t }}</p>
      </div>
    </div>
  </div>
</section>

<section class="sezione" id="fresh-water-watch">
  <div class="contenitore">
    {# Il riquadro e i tre passaggi sono la stessa cosa: che cos'è Fresh Water
       Watch e come ci si entra. Stanno dentro un blocco solo. #}
    <div class="fww-blocco">
      <div class="fww">
        <div>
          <p class="etichetta">{{ c.fresh_water_watch.etichetta }}</p>
          <h3>{{ c.fresh_water_watch.titolo }}</h3>
          {{ parti.paragrafi(c.fresh_water_watch.paragrafi) }}
          <p class="bottoni" style="margin-bottom:0">
            <a class="bottone" href="{{ c.fresh_water_watch.link }}" rel="noopener">{{ c.fresh_water_watch.link_testo }} ↗</a>
          </p>
        </div>
        {{ parti.qr_coppia(c.fresh_water_watch.qr) }}
      </div>

      <div class="fww-passi">
        <h3>{{ c.fresh_water_watch.partecipare.titolo }}</h3>
        <p>{{ c.fresh_water_watch.partecipare.intro|t }}</p>
        {{ parti.roadmap(c.fresh_water_watch.partecipare.passi) }}
      </div>
    </div>
  </div>
</section>

<section class="sezione-scura" id="macroinvertebrati">
  <div class="contenitore">
    {{ parti.testa_doppia('La sperimentazione', c.macroinvertebrati.titolo, c.macroinvertebrati.intro) }}
    <ul class="elenco-spunte">
      {% for v in c.macroinvertebrati.voci %}
      <li><b>{{ v.titolo }}.</b> {{ v.testo|t }}</li>
      {% endfor %}
    </ul>
    <div style="margin-top:2rem">
      {{ parti.galleria(c.macroinvertebrati.foto) }}
    </div>
  </div>
</section>

<section class="sezione">
  <div class="contenitore">
    {{ parti.testa_doppia('I dati', c.campagne.titolo, c.campagne.intro) }}
    <div class="campagne-griglia">
      {% for b in impostazioni.menu if b.pagina.startswith('campagna') %}
      <a class="campagna-box" href="{{ b.pagina }}.html">
        <span class="campagna-anni">{{ b.voce }}</span>
        <span class="campagna-desc">Dashboard interattiva e report da scaricare.</span>
        <span class="campagna-vai">Vedi i risultati →</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

{% endblock %}

{% block script %}
<script>
/* Il percorso di Fresh Water Watch: senza JavaScript i passaggi si leggono
   tutti, uno sotto l'altro. Con JavaScript diventano tappe da percorrere. */
(function () {
  var r = document.querySelector('[data-roadmap]');
  if (!r) return;
  var fila = r.querySelector('.roadmap-tappe');
  var tappe = [].slice.call(r.querySelectorAll('.roadmap-tappa'));
  var pannelli = [].slice.call(r.querySelectorAll('.roadmap-pannello'));
  var naviga = r.querySelector('.roadmap-naviga');
  var conta = r.querySelector('.roadmap-conta');
  var frecce = [].slice.call(r.querySelectorAll('.roadmap-freccia'));
  if (tappe.length < 2 || tappe.length !== pannelli.length) return;

  fila.hidden = false;
  naviga.hidden = false;
  fila.setAttribute('role', 'tablist');
  fila.setAttribute('aria-label', 'I passaggi per caricare i rilievi');

  tappe.forEach(function (t, i) {
    t.id = 'tappa-' + (i + 1);
    t.setAttribute('role', 'tab');
    t.setAttribute('aria-controls', 'pannello-' + (i + 1));
    pannelli[i].id = 'pannello-' + (i + 1);
    pannelli[i].setAttribute('role', 'tabpanel');
    pannelli[i].setAttribute('aria-labelledby', t.id);
    pannelli[i].setAttribute('tabindex', '0');
    t.addEventListener('click', function () { vai(i); });
  });

  var corrente = 0;

  function vai(i, muoviIlFuoco) {
    corrente = Math.max(0, Math.min(tappe.length - 1, i));
    tappe.forEach(function (t, n) {
      var attiva = n === corrente;
      t.setAttribute('aria-selected', attiva ? 'true' : 'false');
      t.setAttribute('tabindex', attiva ? '0' : '-1');
      t.classList.toggle('fatta', n < corrente);
      pannelli[n].hidden = !attiva;
    });
    /* la linea verde arriva fino alla tappa in cui siamo */
    fila.style.setProperty('--avanzamento', corrente / (tappe.length - 1));
    conta.textContent = 'Passaggio ' + (corrente + 1) + ' di ' + tappe.length;
    frecce[0].disabled = corrente === 0;
    frecce[1].disabled = corrente === tappe.length - 1;
    if (muoviIlFuoco) tappe[corrente].focus();
  }

  frecce.forEach(function (f) {
    f.addEventListener('click', function () {
      vai(corrente + parseInt(f.dataset.passo, 10));
    });
  });

  fila.addEventListener('keydown', function (ev) {
    var salto = ev.key === 'ArrowRight' ? 1 : ev.key === 'ArrowLeft' ? -1 : 0;
    if (salto) { ev.preventDefault(); vai(corrente + salto, true); return; }
    if (ev.key === 'Home') { ev.preventDefault(); vai(0, true); }
    if (ev.key === 'End') { ev.preventDefault(); vai(tappe.length - 1, true); }
  });

  vai(0);
})();
</script>
{% endblock %}
