<!doctype html>
<html lang="{{ impostazioni.sito.lingua }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block titolo %}{{ c.titolo }} · {{ impostazioni.sito.nome }}{% endblock %}</title>
  <meta name="description" content="{% block descrizione %}{{ c.sottotitolo }}{% endblock %}">
  <link rel="icon" href="favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800;900&family=Barlow+Condensed:wght@700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="assets/css/sito.css?v={{ versione.css }}">
</head>
<body>
<a class="salta" href="#contenuto">Vai al contenuto principale</a>

<header class="testata">
  <div class="contenitore testata-interna">
    <a class="marchio" href="index.html">
      {# Tre onde: l'acqua che scorre. Stesso segno del favicon. #}
      <svg class="marchio-segno" viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <g fill="none" stroke="currentColor" stroke-width="6.5" stroke-linecap="round">
          <path d="M9 22 Q15 15 21 22 T33 22 T45 22 T55 22"/>
          <path d="M9 32 Q15 25 21 32 T33 32 T45 32 T55 32"/>
          <path d="M9 42 Q15 35 21 42 T33 42 T45 42 T55 42"/>
        </g>
      </svg>
      <span class="marchio-testo">
        <span class="marchio-nome">{{ impostazioni.sito.nome }}</span>
        <span class="marchio-claim">{{ impostazioni.sito.claim }}</span>
      </span>
    </a>
    <nav class="menu" aria-label="Navigazione principale">
      <ul>
        {% for voce in impostazioni.menu %}
        <li><a href="{{ voce.pagina }}.html"{% if voce.pagina == pagina %} aria-current="page"{% endif %}>{{ voce.voce }}</a></li>
        {% endfor %}
      </ul>
    </nav>
    {# Il bottone apre l'elenco delle campagne: ogni voce porta dritta alla
       dashboard di quella campagna. Si apre col passaggio del mouse, con il
       tasto di tabulazione e, sul telefono, con un tocco. #}
    <div class="testata-dati">
      <button type="button" class="testata-azione" aria-expanded="false" aria-controls="menu-dati">
        {{ impostazioni.testata.voce }}
        <span class="testata-freccia" aria-hidden="true">▾</span>
      </button>
      <ul class="testata-tendina" id="menu-dati">
        {% for b in impostazioni.menu if b.pagina.startswith('campagna') %}
        <li><a href="{{ b.pagina }}.html#{{ impostazioni.testata.ancora }}">{{ b.voce }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</header>

<main id="contenuto">
{% block contenuto %}{% endblock %}
</main>

<footer>
  <div class="contenitore">
    <div>
      <h2>{{ impostazioni.sito.nome }}</h2>
      <p>{{ impostazioni.pie_di_pagina.testo }}</p>
      <p>{{ impostazioni.pie_di_pagina.dati }}</p>
      <p class="footer-legale">{{ impostazioni.pie_di_pagina.licenza }}</p>
    </div>
    <div>
      <h2>Collegamenti</h2>
      <ul>
        {% for l in impostazioni.pie_di_pagina.link %}
        <li><a href="{{ l.url }}" rel="noopener">{{ l.voce }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
</footer>

<script>
/* La tendina dei dati si apre da sola al passaggio del mouse e con il tasto di
   tabulazione, che sono regole del foglio di stile. Qui si aggiunge il tocco,
   che sul telefono e sul tablet non ha un «passaggio del mouse», e la
   chiusura con Esc o cliccando altrove. */
(function () {
  var gruppo = document.querySelector('.testata-dati');
  if (!gruppo) return;
  var bottone = gruppo.querySelector('.testata-azione');

  function chiudi() { bottone.setAttribute('aria-expanded', 'false'); }

  bottone.addEventListener('click', function () {
    var aperta = bottone.getAttribute('aria-expanded') === 'true';
    bottone.setAttribute('aria-expanded', aperta ? 'false' : 'true');
  });
  document.addEventListener('click', function (ev) {
    if (!gruppo.contains(ev.target)) chiudi();
  });
  document.addEventListener('keydown', function (ev) {
    if (ev.key === 'Escape') chiudi();
  });
  gruppo.addEventListener('mouseleave', chiudi);
})();

/* Arrivando con un'ancora nell'indirizzo — per esempio #dashboard — il browser
   salta al punto giusto subito, ma le dashboard e le fotografie si disegnano
   dopo e spostano tutto più in basso. Qui si rifà il salto quando la pagina ha
   finito di caricare, a meno che nel frattempo non si sia già scorso a mano. */
(function () {
  if (!location.hash || location.hash.length < 2) return;
  var mosso = false;
  function haScorso() { mosso = true; }
  window.addEventListener('wheel', haScorso, { passive: true, once: true });
  window.addEventListener('touchmove', haScorso, { passive: true, once: true });
  window.addEventListener('keydown', haScorso, { once: true });

  window.addEventListener('load', function () {
    setTimeout(function () {
      if (mosso) return;
      var meta;
      try { meta = document.querySelector(location.hash); } catch (e) { return; }
      if (meta) meta.scrollIntoView();
    }, 450);
  });
})();
</script>

{% block script %}{% endblock %}
</body>
</html>
