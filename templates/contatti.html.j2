{% extends "base.html.j2" %}
{% import "parti.html.j2" as parti %}

{% block contenuto %}

{{ parti.hero(c, 'Contatti') }}

{# ------------------------------------------------------------ il bollettino #}

<section class="sezione" id="bollettino">
  <div class="contenitore">
    {{ parti.testa_doppia(c.bollettino.etichetta, c.bollettino.titolo, c.bollettino.intro) }}

    <article class="articolo-evidenza">
      <div class="testo">
        <span class="occhiello">{{ c.bollettino.in_evidenza.occhiello }}</span>
        <h3>{{ c.bollettino.in_evidenza.titolo }}</h3>
        <p class="articolo-firma">di {{ c.bollettino.in_evidenza.autore }}</p>
        <p class="articolo-sommario">{{ c.bollettino.in_evidenza.sommario|t }}</p>
        {{ parti.paragrafi(c.bollettino.in_evidenza.paragrafi) }}
        <p class="bottoni" style="margin-bottom:0">
          <a class="bottone" href="{{ c.bollettino.in_evidenza.link }}" rel="noopener">
            {{ c.bollettino.in_evidenza.link_testo }} ↗</a>
        </p>
      </div>
      <figure>
        <img src="assets/img/{{ c.bollettino.in_evidenza.foto }}"
             alt="{{ c.bollettino.in_evidenza.foto_descrizione }}" loading="lazy" width="1200" height="900">
      </figure>
    </article>

    <div class="newsletter">
      <div>
        <h3>{{ c.bollettino.newsletter.titolo }}</h3>
        <p>{{ c.bollettino.newsletter.testo|t }}</p>
      </div>
      <a class="bottone" href="{{ c.bollettino.newsletter.link }}" rel="noopener">
        {{ c.bollettino.newsletter.link_testo }} ↗</a>
    </div>
  </div>
</section>

{# ----------------------------------------------------------- segnalazioni #}

<section class="sezione sezione-chiara" id="segnalazioni">
  <div class="contenitore">
    {{ parti.testa_doppia('Scrivici', c.segnalazioni.titolo, c.segnalazioni.intro) }}
    <div class="cs-griglia">
      <form class="modulo" id="modulo-segnalazione" data-destinatario="{{ c.segnalazioni.email }}">
        <label>
          <span>{{ c.segnalazioni.campi.nome }}</span>
          <input type="text" name="nome" autocomplete="name" required>
        </label>
        <label>
          <span>{{ c.segnalazioni.campi.email }}</span>
          <input type="email" name="email" autocomplete="email" required>
        </label>
        <label>
          <span>{{ c.segnalazioni.campi.luogo }}</span>
          <input type="text" name="luogo" placeholder="Per esempio: Ponte Mammolo, sponda destra">
        </label>
        <label>
          <span>{{ c.segnalazioni.campi.messaggio }}</span>
          <textarea name="messaggio" required></textarea>
        </label>
        <div class="bottoni">
          <button class="bottone" type="submit">{{ c.segnalazioni.campi.invia }}</button>
          <a class="bottone bottone-chiaro" href="mailto:{{ c.segnalazioni.email }}">{{ c.segnalazioni.email }}</a>
        </div>
        <p style="font-size:.88rem;color:var(--text-dim);margin:0">{{ c.segnalazioni.nota|t }}</p>
      </form>
      <div class="riquadro">
        <h3>{{ c.segnalazioni.consigli.titolo }}</h3>
        <ul class="elenco-spunte">
          {% for v in c.segnalazioni.consigli.voci %}
          <li>{{ v|t }}</li>
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</section>

{# --------------------------------------------- la rete, ultima sezione #}

<section class="sezione" id="rete">
  <div class="contenitore">
    {{ parti.testa_doppia(c.rete.etichetta, c.rete.titolo, c.rete.intro) }}
    <div class="rete-griglia">
      {% for r in c.rete.realta %}
      {% if r.get('sito') %}
      <a class="rete-card" href="{{ r.sito }}" rel="noopener">
        <span class="logo"><img src="assets/img/{{ r.logo }}" alt="{{ r.nome }}" loading="lazy"></span>
        <h3>{{ r.nome }}</h3>
        <p>{{ r.ruolo }}</p>
        <span class="vai">Vai al sito ↗</span>
      </a>
      {% else %}
      <div class="rete-card">
        <span class="logo"><img src="assets/img/{{ r.logo }}" alt="{{ r.nome }}" loading="lazy"></span>
        <h3>{{ r.nome }}</h3>
        <p>{{ r.ruolo }}</p>
        <span></span>
      </div>
      {% endif %}
      {% endfor %}
    </div>

    <h3 class="sotto-titolo">{{ c.rete.altri.titolo }}</h3>
    <ul class="rete-altri">
      {% for a in c.rete.altri.voci %}
      <li>
        <b>{{ a.nome }}</b>
        <span>{{ a.ruolo }}</span>
        {% if a.get('sito') %}<a href="{{ a.sito }}" rel="noopener">Vai al sito ↗</a>{% endif %}
      </li>
      {% endfor %}
    </ul>

    <div class="nota">
      <p><b>{{ c.rete.supervisione.titolo }}.</b> {{ c.rete.supervisione.testo|t }}</p>
    </div>
  </div>
</section>

{% endblock %}

{% block script %}
<script>
/* Il modulo prepara una email già compilata: il sito è statico e non invia
   nulla da solo, così non servono servizi esterni né dati conservati altrove. */
(function () {
  var modulo = document.getElementById('modulo-segnalazione');
  if (!modulo) return;
  modulo.addEventListener('submit', function (ev) {
    ev.preventDefault();
    var d = new FormData(modulo);
    var corpo = [
      'Nome: ' + (d.get('nome') || ''),
      'Email: ' + (d.get('email') || ''),
      'Luogo: ' + (d.get('luogo') || ''),
      '',
      d.get('messaggio') || ''
    ].join('\n');
    window.location.href = 'mailto:' + modulo.dataset.destinatario +
      '?subject=' + encodeURIComponent('Segnalazione sul fiume Aniene') +
      '&body=' + encodeURIComponent(corpo);
  });
})();
</script>
{% endblock %}
