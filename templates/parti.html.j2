{# Pezzi riutilizzati da più pagine.
   Nei testi di contenuto il grassetto si scrive con **due asterischi**: il
   filtro |t lo trasforma in <strong> e rende innocuo tutto il resto. #}

{% macro hero(c, occhiello='', compatto=false) %}
<section class="hero{% if compatto %} hero-compatto{% endif %}">
  <div class="contenitore hero-griglia">
    <div>
      {% if occhiello %}<p class="hero-occhiello">{{ occhiello }}</p>{% endif %}
      <h1>{{ c.titolo }}</h1>
      <p>{{ c.sottotitolo|t }}</p>
    </div>
    {% if c.get('foto_copertina') and not compatto %}
    <figure>
      <img src="assets/img/{{ c.foto_copertina }}" alt="{{ c.foto_copertina_descrizione }}" width="1600" height="900">
      <figcaption>{{ c.foto_copertina_descrizione }}</figcaption>
    </figure>
    {% endif %}
  </div>
</section>
{% endmacro %}


{% macro testa(etichetta, titolo, testo='') %}
{% if etichetta %}<p class="etichetta">{{ etichetta }}</p>{% endif %}
<h2 class="titolo-sezione">{{ titolo }}</h2>
{% if testo %}<p class="occhiello-testo">{{ testo|t }}</p>{% endif %}
{% endmacro %}


{# Intestazione di sezione su due colonne: il titolo a sinistra e il testo di
   apertura a destra, così la riga è piena e il testo non resta sospeso. #}
{% macro testa_doppia(etichetta, titolo, testo) %}
<div class="testa-doppia">
  <div>
    {% if etichetta %}<p class="etichetta">{{ etichetta }}</p>{% endif %}
    <h2 class="titolo-sezione">{{ titolo }}</h2>
  </div>
  <p class="occhiello-testo">{{ testo|t }}</p>
</div>
{% endmacro %}


{% macro paragrafi(elenco) %}
{% for p in elenco %}<p>{{ p|t }}</p>{% endfor %}
{% endmacro %}


{# Una fotografia larga subito sotto il titolo, per dare respiro alla pagina. #}
{% macro foto_larga(file, descrizione) %}
<figure class="foto-larga">
  <img src="assets/img/{{ file }}" alt="{{ descrizione }}" loading="lazy" width="1800" height="1000">
  <figcaption>{{ descrizione }}</figcaption>
</figure>
{% endmacro %}


{% macro stazioni(elenco) %}
<ul class="stazioni-elenco">
  {% for s in elenco %}
  <li>
    <span class="stazione-codice">{{ s.codice }}</span>
    <div>
      <span class="stazione-nome">{{ s.nome }}</span>
      <p>{{ s.testo|t }}</p>
    </div>
  </li>
  {% endfor %}
</ul>
{% endmacro %}


{# L'elenco delle stazioni accanto alla mappa dei punti di campionamento. #}
{% macro luoghi(blocco, svg='') %}
<div class="luoghi">
  <div>
    <p class="occhiello-testo">{{ blocco.intro|t }}</p>
    {{ stazioni(blocco.stazioni) }}
  </div>
  {% if blocco.get('mappa') %}
  <figure class="mappa">
    <img src="assets/img/{{ blocco.mappa.file }}" alt="{{ blocco.mappa.descrizione }}" loading="lazy" width="1530" height="705">
    <figcaption>{{ blocco.mappa.descrizione }}</figcaption>
  </figure>
  {% elif svg %}
  <figure class="mappa">
    {{ svg }}
    <figcaption>{{ blocco.mappa_didascalia }}</figcaption>
  </figure>
  {% endif %}
</div>
{% endmacro %}


{% macro galleria(foto) %}
<div class="galleria">
  {% for f in foto %}
  <figure>
    <img src="assets/img/{{ f.file }}" alt="{{ f.descrizione }}" loading="lazy" width="1200" height="800">
    <figcaption>{{ f.descrizione }}</figcaption>
  </figure>
  {% endfor %}
</div>
{% endmacro %}


{#
  La dashboard interattiva. Il contenuto viene costruito dal browser a partire
  dal file dati/<nome>.json e dalle soglie in dati/parametri.json.
#}
{% macro dashboard(blocco, riepilogo, guida=none) %}
{% set r = riepilogo(blocco.dati) %}
<h2 class="titolo-sezione">{{ blocco.titolo }}</h2>
<p class="occhiello-testo">{{ blocco.intro|t }}</p>
{% if guida %}
{# Le istruzioni stanno sopra al grafico: si leggono prima di provare. #}
<div class="guida-dash">
  <h3>{{ guida.titolo }}</h3>
  <p>{{ guida.intro|t }}</p>
  <ol>
    {% for passo in guida.passi %}<li>{{ passo|t }}</li>{% endfor %}
  </ol>
  <details>
    <summary>{{ guida.esempi_invito }}</summary>
    <div class="guida-dash-esempi">
      {% for e in guida.esempi %}
      <article>
        <h4>{{ e.titolo }}</h4>
        <p>{{ e.testo|t }}</p>
      </article>
      {% endfor %}
    </div>
  </details>
</div>
{% endif %}
<div class="dashboard" data-dati="{{ blocco.dati }}">
  <div class="dash-guida">
    <p><strong>Caricamento dei dati…</strong>
      {{ r.stazioni }} punti di campionamento, {{ r.campagne }} campagne da {{ r.da }}
      a {{ r.a }}, {{ r.misure|numero }} misure.
      Se il grafico non compare, il browser sta bloccando il caricamento dei dati:
      prova ad aggiornare la pagina.</p>
  </div>
</div>
{% endmacro %}


{% macro classe_stato(stato) %}
{%- set s = stato|lower -%}
{%- if 'critic' in s -%}stato-critico
{%- elif 'norma' in s or 'limite' in s or 'nessuna' in s -%}stato-ok
{%- else -%}stato-attenzione
{%- endif -%}
{% endmacro %}


{# Schede dei parametri calate su una campagna: cosa misura (dalla scheda
   generale) più cosa abbiamo trovato e le cause (dal testo della campagna). #}
{% macro schede_campagna(blocco, parametri) %}
<h2 class="titolo-sezione">{{ blocco.titolo }}</h2>
<p class="occhiello-testo">{{ blocco.intro|t }}</p>
<div class="schede-parametri">
  {% for v in blocco.voci %}
  {% set p = parametri[v.parametro] %}
  <article class="parametro">
    {% if p.get('foto') %}
    <img src="assets/img/{{ p.foto }}" alt="" loading="lazy" width="1200" height="800">
    {% endif %}
    <div class="parametro-corpo">
      <h3>{{ p.nome }}</h3>
      <p class="parametro-unita">{{ p.unita }}</p>
      {% if v.stato %}<span class="stato {{ classe_stato(v.stato) }}">{{ v.stato }}</span>{% endif %}
      <dl>
        <dt>Cosa misura</dt>
        <dd>{{ (v.cosa_misura if v.cosa_misura is defined and v.cosa_misura else p.cosa_misura)|t }}</dd>
        {% if v.cosa_trovato %}
        <dt>Cosa abbiamo trovato</dt>
        <dd>{{ v.cosa_trovato|t }}</dd>
        {% endif %}
        {% if v.cause %}
        <dt>Possibili cause</dt>
        <dd>{{ v.cause|t }}</dd>
        {% endif %}
      </dl>
      {# La parte tecnica resta a disposizione ma non occupa la scheda:
         nove schede aperte tutte insieme diventano un muro. #}
      <details class="scheda-tecnica">
        <summary>Come si legge, soglia per soglia</summary>
        <p>{{ (v.come_leggerlo if v.come_leggerlo is defined and v.come_leggerlo else p.come_leggerlo)|t }}</p>
      </details>
    </div>
  </article>
  {% endfor %}
</div>
{% endmacro %}


{# Schede generali dei parametri, senza il commento sui risultati. #}
{% macro schede_generali(ordine, parametri) %}
<div class="schede-parametri">
  {% for nome in ordine %}
  {% set p = parametri[nome] %}
  <article class="parametro">
    {% if p.get('foto') %}
    <img src="assets/img/{{ p.foto }}" alt="" loading="lazy" width="1200" height="800">
    {% endif %}
    <div class="parametro-corpo">
      <h3>{{ p.nome }}</h3>
      <p class="parametro-unita">{{ p.unita }}</p>
      <dl>
        <dt>Cosa misura</dt>
        <dd>{{ p.cosa_misura|t }}</dd>
        {% if p.soglie %}
        <dt>Possibili cause di superamento</dt>
        <dd>{{ p.soglie[-1].cause|t }}</dd>
        {% endif %}
      </dl>
      {% if p.soglie %}
      <p class="scheda-soglie">
        {% for sg in p.soglie %}
        <span class="pastiglia lvl-{{ sg.livello }}">{{ sg.etichetta.split('·')[0]|trim }}</span>
        {% endfor %}
      </p>
      {% endif %}
      <details class="scheda-tecnica">
        <summary>Come si legge, soglia per soglia</summary>
        <p>{{ p.come_leggerlo|t }}</p>
      </details>
    </div>
  </article>
  {% endfor %}
</div>
{% endmacro %}


{# I documenti da scaricare: si deve capire a colpo d'occhio che sono file. #}
{% macro report(blocco, peso, pagine) %}
<h2 class="titolo-sezione">{{ blocco.titolo }}</h2>
<p class="occhiello-testo">{{ blocco.intro|t }}</p>
<div class="report-griglia">
  {% for d in blocco.documenti %}
  <a class="report-card" href="{{ d.file }}" download>
    <span class="report-icona" aria-hidden="true">PDF</span>
    <h3>{{ d.titolo }}</h3>
    <p>{{ d.descrizione|t }}</p>
    <span class="report-meta">
      {%- set p = pagine(d.file) -%}
      {%- set k = peso(d.file) -%}
      {{ p }}{% if p and k %} · {% endif %}{{ k }}
    </span>
    <span class="report-azione">Scarica il PDF</span>
  </a>
  {% endfor %}
</div>
{% endmacro %}


{# Due bottoni grandi che portano alle sezioni della stessa pagina. #}
{% macro bottoni_sezione(voci) %}
<div class="bottoni-sezione">
  {% for v in voci %}
  <a class="bottone-sezione" href="#{{ v.ancora }}">
    <span class="bottone-sezione-numero" aria-hidden="true">{{ loop.index }}</span>
    <strong>{{ v.nome }}</strong>
    <span>{{ v.descrizione }}</span>
  </a>
  {% endfor %}
</div>
{% endmacro %}


{# La mappa dei punti di campionamento, disegnata dai dati della campagna. #}
{% macro mappa_dati(svg, didascalia) %}
<figure class="mappa">
  {{ svg }}
  <figcaption>{{ didascalia }}</figcaption>
</figure>
{% endmacro %}


{# "In breve": il testo a sinistra e, accanto, i dati che restano in mente.
   Serve a non lasciare mezza pagina vuota sotto il titolo. #}
{% macro sintesi_con_spalla(blocco) %}
<div class="testo-lato">
  <div>{{ paragrafi(blocco.paragrafi) }}</div>
  <div class="spalla">
    <div class="spalla-numeri">
      <h3>{{ blocco.spalla.titolo }}</h3>
      <dl>
        {% for v in blocco.spalla.voci %}
        <div>
          <dt>{{ v.valore }}</dt>
          <dd>{{ v.testo|t }}</dd>
        </div>
        {% endfor %}
      </dl>
      {% if blocco.spalla.get('link') %}
      <a class="bottone bottone-piccolo" href="{{ blocco.spalla.link }}">{{ blocco.spalla.link_testo }} →</a>
      {% endif %}
    </div>
  </div>
</div>
{% endmacro %}


{# Come si calcola il LIMeco: quattro parametri, un punteggio ciascuno, la
   media, una delle cinque classi. I colori sono gli stessi della tabella
   delle soglie qui sotto e delle soglie nelle dashboard. #}
{% macro schema_limeco() %}
{% set classi = [
  ('#2D7A9A', '#fff', 'Elevato'), ('#8CA918', '#fff', 'Buono'),
  ('#E9C23B', '#4F4310', 'Sufficiente'), ('#E0812E', '#fff', 'Scarso'),
  ('#B03A2E', '#fff', 'Cattivo')] %}
{% set parametri_limeco = [
  ('Ossigeno', 'disciolto'), ('Azoto', 'ammoniacale'),
  ('Azoto', 'nitrico'), ('Fosforo', 'totale')] %}
<figure class="schema-limeco">
  <svg viewBox="0 0 520 286" role="img" xmlns="http://www.w3.org/2000/svg"
       aria-label="Come si calcola il LIMeco: dai quattro parametri si ricava un punteggio ciascuno, la media colloca il fiume in una delle cinque classi di qualità."
       style="width:100%;height:auto;display:block">
    <g font-family="Barlow, sans-serif" fill="#1A3340">
      {% for riga_uno, riga_due in parametri_limeco %}
      {% set x = 4 + loop.index0 * 130 %}
      <g>
        <rect x="{{ x }}" y="6" width="118" height="52" rx="7"
              fill="#fff" stroke="#D8D3C8" stroke-width="1.5"/>
        <text x="{{ x + 59 }}" y="28" text-anchor="middle" font-size="12.5" font-weight="700">{{ riga_uno }}</text>
        <text x="{{ x + 59 }}" y="44" text-anchor="middle" font-size="12.5" font-weight="700">{{ riga_due }}</text>
        <path d="M{{ x + 59 }} 60 L{{ x + 59 }} 78" stroke="#8CA918" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M{{ x + 54 }} 72 L{{ x + 59 }} 79 L{{ x + 64 }} 72" fill="none"
              stroke="#8CA918" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      </g>
      {% endfor %}

      <rect x="4" y="84" width="512" height="42" rx="7" fill="#1A3340"/>
      <text x="260" y="110" text-anchor="middle" font-size="13.5" font-weight="700" fill="#F0EDE6">
        a ciascuno un punteggio da 1 a 5, poi se ne fa la media
      </text>
      <path d="M260 128 L260 150" stroke="#8CA918" stroke-width="2.5" stroke-linecap="round"/>
      <path d="M254 144 L260 151 L266 144" fill="none"
            stroke="#8CA918" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>

      {% for colore, testo, nome in classi %}
      {% set x = 4 + loop.index0 * 103 %}
      <rect x="{{ x }}" y="156" width="99" height="46"
            rx="{% if loop.first %}7{% elif loop.last %}7{% else %}3{% endif %}" fill="{{ colore }}"/>
      <text x="{{ x + 49 }}" y="177" text-anchor="middle" font-size="17" font-weight="900"
            font-family="Barlow Condensed, sans-serif" fill="{{ testo }}">{{ loop.index }}</text>
      <text x="{{ x + 49 }}" y="194" text-anchor="middle" font-size="11.5" font-weight="700" fill="{{ testo }}">{{ nome }}</text>
      {% endfor %}

      <text x="4" y="224" font-size="11.5" font-weight="700" fill="#6B7A85">↑ fiume in salute</text>
      <text x="516" y="224" text-anchor="end" font-size="11.5" font-weight="700" fill="#6B7A85">fiume compromesso ↑</text>
      <text x="260" y="256" text-anchor="middle" font-size="12.5" fill="#4A5568">
        Lo stesso schema vale per le linee tratteggiate delle dashboard:
      </text>
      <text x="260" y="274" text-anchor="middle" font-size="12.5" fill="#4A5568">
        ogni soglia segna il passaggio da una classe alla successiva.
      </text>
    </g>
  </svg>
</figure>
{% endmacro %}
